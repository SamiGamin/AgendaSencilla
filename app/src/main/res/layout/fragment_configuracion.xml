<?xml version="1.0" encoding="utf-8"?>
<!-- FRAGMENT CONFIGURACION - OPTIMIZADO PARA ADULTOS MAYORES -->
<!-- Titulos grandes, botones toggle 56dp, switch con area tactil amplia -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.configuracion.ConfiguracionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- CARD: MODO DE TEMA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Icono y titulo de seccion -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:contentDescription="@string/modo_tema"
                        android:src="@drawable/ic_theme"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_titulo_tema"
                        style="@style/TextAppearance.AgendaSencilla.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modo_tema" />

                </LinearLayout>

                <!-- Descripcion -->
                <TextView
                    style="@style/TextAppearance.AgendaSencilla.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:text="@string/modo_tema_descripcion" />

                <!-- Toggle Group para tema -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_tema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tema_claro"
                        style="@style/Widget.AgendaSencilla.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/claro"
                        app:icon="@drawable/ic_light_mode" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tema_oscuro"
                        style="@style/Widget.AgendaSencilla.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/oscuro"
                        app:icon="@drawable/ic_dark_mode" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tema_sistema"
                        style="@style/Widget.AgendaSencilla.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/sistema"
                        app:icon="@drawable/ic_phone" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: TAMANO DE LAS LETRAS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Icono y titulo de seccion -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:contentDescription="@string/tamano_letras"
                        android:src="@drawable/ic_text_size"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_titulo_tamano_fuente"
                        style="@style/TextAppearance.AgendaSencilla.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tamano_letras" />

                </LinearLayout>

                <!-- Descripcion -->
                <TextView
                    style="@style/TextAppearance.AgendaSencilla.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:text="@string/tamano_letras_descripcion" />

                <!-- Toggle Group para tamano de fuente -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_tamano_fuente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tamano_normal"
                        style="@style/Widget.AgendaSencilla.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/normal"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tamano_grande"
                        style="@style/Widget.AgendaSencilla.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/grande"
                        android:textSize="18sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tamano_mas_grande"
                        style="@style/Widget.AgendaSencilla.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_medium"
                        android:layout_weight="1"
                        android:text="@string/mas_grande"
                        android:textSize="22sp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: ACCESIBILIDAD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Icono y titulo de seccion -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:contentDescription="@string/accesibilidad"
                        android:src="@drawable/ic_accessibility"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_titulo_accesibilidad"
                        style="@style/TextAppearance.AgendaSencilla.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/accesibilidad" />

                </LinearLayout>

                <!-- Switch para lectura en voz -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_lectura_en_voz"
                    style="@style/Widget.AgendaSencilla.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:minHeight="@dimen/touch_target_large"
                    android:padding="@dimen/spacing_small"
                    android:text="@string/leer_nombres_voz"
                    android:textSize="@dimen/text_size_body" />

                <!-- Descripcion de la funcion -->
                <TextView
                    style="@style/TextAppearance.AgendaSencilla.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxlarge"
                    android:text="@string/leer_nombres_voz_descripcion" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- INFORMACION DE LA APP -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    style="@style/TextAppearance.AgendaSencilla.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.AgendaSencilla.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:text="@string/version_app" />

                <TextView
                    style="@style/TextAppearance.AgendaSencilla.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="@string/descripcion_app" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>