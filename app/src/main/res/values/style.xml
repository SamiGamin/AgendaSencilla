<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ESTILOS OPTIMIZADOS PARA ADULTOS MAYORES -->

    <!-- Estilo base (requerido para la jerarquia de estilos) -->
    <style name="Widget.AgendaSencilla" parent="" />
    <style name="TextAppearance.AgendaSencilla" parent="TextAppearance.Material3.BodyMedium" />

    <!-- ESTILOS DE TEXTO -->

    <!-- Nombre de contacto - Grande y prominente -->
    <style name="TextAppearance.AgendaSencilla.ContactName" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Telefono de contacto - Claro y legible -->
    <style name="TextAppearance.AgendaSencilla.PhoneNumber" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Titulos de seccion -->
    <style name="TextAppearance.AgendaSencilla.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Cuerpo de texto general -->
    <style name="TextAppearance.AgendaSencilla.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Texto secundario/caption -->
    <style name="TextAppearance.AgendaSencilla.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Numero en display del marcador -->
    <style name="TextAppearance.AgendaSencilla.PhoneDisplay" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_size_phone_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- BOTON DE LLAMAR - PROMINENTE (verde, grande) -->
    <style name="Widget.AgendaSencilla.CallButton" parent="Widget.Material3.Button">
        <item name="android:minWidth">@dimen/call_button_width</item>
        <item name="android:minHeight">@dimen/call_button_height</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/call_button_color</item>
        <item name="cornerRadius">@dimen/button_corner_radius_large</item>
        <item name="iconSize">@dimen/icon_size_medium</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/spacing_small</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Boton de llamar pequeno (para cards) -->
    <style name="Widget.AgendaSencilla.CallButton.Compact" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">120dp</item>
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/call_button_color</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconSize">@dimen/icon_size_small</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/spacing_small</item>
    </style>

    <!-- TECLAS DEL MARCADOR (DIALPAD) - ALTURA FIJA PARA TODAS LAS PANTALLAS -->
    <style name="Widget.AgendaSencilla.DialpadButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- CARDS DE CONTACTO -->
    <style name="Widget.AgendaSencilla.ContactCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="android:layout_margin">@dimen/card_margin</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="Widget.AgendaSencilla.ContactCard.Favorite" parent="Widget.AgendaSencilla.ContactCard">
        <item name="cardCornerRadius">@dimen/card_corner_radius_large</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">?attr/colorPrimaryContainer</item>
    </style>

    <!-- BOTONES DE ACCION SECUNDARIA -->
    <style name="Widget.AgendaSencilla.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target_large</item>
        <item name="android:minHeight">@dimen/touch_target_large</item>
        <item name="iconSize">@dimen/icon_size_medium</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="Widget.AgendaSencilla.IconButton.Favorite" parent="Widget.AgendaSencilla.IconButton">
        <item name="iconTint">@color/selector_favorite_icon</item>
    </style>

    <!-- TOGGLE BUTTONS (configuracion) -->
    <style name="Widget.AgendaSencilla.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- SWITCH DE CONFIGURACION -->
    <style name="Widget.AgendaSencilla.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">@dimen/touch_target_large</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- BARRA DE NAVEGACION INFERIOR -->
    <style name="Widget.AgendaSencilla.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">@dimen/bottom_nav_icon_size</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.AgendaSencilla.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.AgendaSencilla.BottomNav.Inactive</item>
    </style>

    <style name="TextAppearance.AgendaSencilla.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/bottom_nav_label_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AgendaSencilla.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/bottom_nav_label_size</item>
    </style>

    <!-- TOOLBAR PRINCIPAL -->
    <style name="Widget.AgendaSencilla.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="titleTextAppearance">@style/TextAppearance.AgendaSencilla.Toolbar.Title</item>
    </style>

    <style name="TextAppearance.AgendaSencilla.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/toolbar_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- CAMPO DE TEXTO (INPUT) -->
    <style name="Widget.AgendaSencilla.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/button_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/button_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/button_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/button_corner_radius</item>
    </style>

    <style name="Widget.AgendaSencilla.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">@dimen/text_size_phone_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/button_height_large</item>
    </style>

    <!-- ITEM DE HISTORIAL DE LLAMADAS -->
    <style name="AgendaSencilla.HistoryItem" parent="">
        <item name="android:padding">@dimen/history_item_padding</item>
        <item name="android:minHeight">@dimen/touch_target_xxlarge</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- FAB (BOTON FLOTANTE) -->
    <style name="Widget.AgendaSencilla.FAB" parent="Widget.Material3.FloatingActionButton.Large.Primary">
        <item name="fabCustomSize">@dimen/fab_size</item>
        <item name="maxImageSize">@dimen/fab_icon_size</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ESTILOS LEGACY (para mantener compatibilidad) -->
    <style name="Widget.App.Tecla" parent="Widget.AgendaSencilla.DialpadButton" />
    <style name="Widget.App.DialpadButton" parent="Widget.AgendaSencilla.DialpadButton" />

</resources>